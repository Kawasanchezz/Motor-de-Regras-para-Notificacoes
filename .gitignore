# ======================================================================
# .gitignore: Java / Spring Boot / Maven / Docker
# Regra de ouro: só código, configuração sem segredos e documentação sobem
# para o Git. Segredos, build, dados locais e arquivos de IA ficam de fora.
# ======================================================================

# --- Build e saída do Maven ---
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml
.flattened-pom.xml
.mvn/timing.properties
HELP.md

# --- Segredos e ambiente (NUNCA entram no Git) ---
# Só o exemplo, sem valores reais, é versionado.
.env
.env.*
!.env.example
.envrc
*.local
secrets/
credentials/
private/
*.secret
*.secrets
*.secrets.json
*.secrets.yaml
*.secrets.yml
secrets.json
credentials.json
*-credentials.json
service-account*.json
client_secret*.json
# Chaves, certificados e keystores
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.p8
*.crt
*.cer
*.der
*.csr
*.jks
*.keystore
*.asc
*.gpg
.gnupg/
.ssh/
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
known_hosts
.git-credentials
.netrc
.pgpass
.htpasswd
# Cofres de senha
*.kdbx

