# --- Bancos locais, dumps e dados ---
# ATENÇÃO: "*.sql" ignora dumps, mas as migrações do Flyway DEVEM ser versionadas
# (exceção logo abaixo). Sem elas o projeto não sobe a partir de um clone limpo.
*.sql
!src/main/resources/db/migration/
!src/main/resources/db/migration/*.sql
*.sql.gz
*.db
*.db-journal
*.db-wal
*.db-shm
*.bak
*.backup
*.dump
*.pgdump
dump.rdb
*.rdb
dump/
dumps/
backup/
backups/
pgdata/
postgres-data/

# --- Docker local ---
docker-compose.override.yml
.docker/

# --- Relatórios de scanners, dumps de memória e falhas ---
gitleaks-report*
trufflehog*.json
semgrep-report*
*.sarif
audit-report*
security-report*
*.hprof
heapdump*
hs_err_pid*
*.core
core.[0-9]*
*.dmp
*.mdmp
*.stackdump
*.pcap
*.pcapng

